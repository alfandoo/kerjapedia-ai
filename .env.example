# KerjaPedia AI — example environment. Copy to .env and fill in values.
# NEVER commit real credentials.

APP_ENV=development

# --- Vector store: artifact | upstash_vector ---
VECTOR_STORE=upstash_vector

# --- Upstash Vector (hosted hybrid embeddings) ---
# Index type: HYBRID | Dense: open-ai/text-embedding-3-small
# Sparse: BM25 | Similarity: COSINE
# Document and query embedding is done by Upstash; the app sends raw text.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=production

# --- Local embedding (artifact/dev pipeline only) ---
EMBEDDING_PROVIDER=hash

# --- LLM (openrouter | groq | local) ---
# Groq serves openai/gpt-oss-120b with much lower latency than free
# OpenRouter routing. Get a key at https://console.groq.com/keys
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=6000

# --- Reranker: heuristic (built in, no extra service) ---

# --- App ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kerjapedia
REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-at-least-12-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
