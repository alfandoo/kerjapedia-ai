# Application
APP_ENV=development
PROJECT_ROOT=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kerjapedia
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=60
SESSION_TTL_MINUTES=480
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RAG providers
VECTOR_STORE=artifact
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
LLM_PROVIDER=local

# Pinecone (required when VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=kerjapedia-regulations
PINECONE_NAMESPACE=production
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Groq (required when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=1200

# Optional OpenAI provider
OPENAI_API_KEY=
