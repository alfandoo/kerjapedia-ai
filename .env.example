APP_ENV=development
PROJECT_ROOT=../../
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/kerjapedia
VECTOR_STORE=artifact
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
INGESTION_EMBEDDING_BATCH_SIZE=16
INGESTION_EMBEDDING_TIMEOUT_SECONDS=120
INGESTION_EMBEDDING_MAX_RETRIES=3
INGESTION_EMBEDDING_RETRY_INITIAL_SECONDS=1
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_WRITE_TIMEOUT_SECONDS=60
PINECONE_WRITE_MAX_RETRIES=3
INGESTION_TARGET_TOKENS=350
INGESTION_MAX_TOKENS=550
INGESTION_OVERLAP_TOKENS=60
INGESTION_MIN_MERGE_TOKENS=180
INGESTION_PARENT_TOKENS=1200
INGESTION_OCR_JOBS=2
LLM_PROVIDER=local
RERANKER_PROVIDER=heuristic
CLAIM_VERIFIER_PROVIDER=deterministic
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_TOKENS=3000
CLAIM_VERIFIER_MODEL=openai/gpt-oss-120b
RAG_FAIL_CLOSED=false
RAG_ALLOW_UNPUBLISHED=true
# Retrieval tuning (calibration winners, 2026-09). Leave HYBRID_ALPHA empty for
# the query-dependent heuristic; it is a no-op on dotproduct Pinecone indexes.
RETRIEVAL_DIVERSITY_LAMBDA=0.7
# Optional fixed hybrid alpha override (e.g. 0.5). Leave unset for the
# query-dependent heuristic; fixed alpha is a no-op on dotproduct indexes.
# RETRIEVAL_HYBRID_ALPHA=
CELERY_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
RAG_TRACE_RETENTION_DAYS=30
RAGAS_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secret
