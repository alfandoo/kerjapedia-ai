# KerjaPedia AI — example environment. Copy to .env and fill in values.
# NEVER commit real credentials.
#
# Data ownership:
#   Neon PostgreSQL   = relational system of record (DATABASE_URL)
#   Supabase Storage  = object/file storage only (SUPABASE_*)
#   Upstash Vector    = retrieval index only (UPSTASH_VECTOR_*)
#   Upstash Redis     = queue/cache/rate-limit (REDIS_URL / CELERY_*)

# --- APP ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-at-least-12-characters

# --- DATABASE / NEON (relational system of record) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kerjapedia

# --- SUPABASE STORAGE (object/file storage only, NOT a second database) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=regulations

# --- UPSTASH REDIS (queue/cache/rate-limit, transient only) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- UPSTASH VECTOR (HYBRID production index) ---
# Dense: open-ai/text-embedding-3-small | Sparse: BM25 | App sends raw text.
VECTOR_STORE=upstash_vector
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=production

# --- LOCAL EMBEDDING (artifact/dev pipeline only, never production) ---
EMBEDDING_PROVIDER=hash

# --- GROQ (production LLM) ---
LLM_PROVIDER=openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=6000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CLAIM_VERIFIER_PROVIDER=groq
CLAIM_VERIFIER_MODEL=openai/gpt-oss-120b

# --- AUTH ---
# Google OAuth is exchanged via Supabase Auth; backend returns Bearer tokens.
# Frontend session cookies (HttpOnly) are set by the Next.js proxy layer.

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=KerjaPedia
EMAIL_OTP_EXPIRY_MINUTES=15

# --- CELERY (async worker; required true in production) ---
CELERY_ENABLED=false

# --- RAG (fail-closed in production) ---
RAG_FAIL_CLOSED=false
RAG_ALLOW_UNPUBLISHED=true

# --- OBSERVABILITY ---
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
RAGAS_ENABLED=false
RAGAS_SAMPLE_RATE=0.05
