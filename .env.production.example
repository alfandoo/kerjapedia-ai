APP_ENV=production
PROJECT_ROOT=/workspace
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/kerjapedia
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
VECTOR_STORE=upstash_vector
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=production
EMBEDDING_PROVIDER=hash
INGESTION_EMBEDDING_BATCH_SIZE=16
INGESTION_EMBEDDING_TIMEOUT_SECONDS=120
INGESTION_EMBEDDING_MAX_RETRIES=3
INGESTION_EMBEDDING_RETRY_INITIAL_SECONDS=1
INGESTION_TARGET_TOKENS=350
INGESTION_MAX_TOKENS=550
INGESTION_OVERLAP_TOKENS=60
INGESTION_MIN_MERGE_TOKENS=180
INGESTION_PARENT_TOKENS=1200
INGESTION_OCR_JOBS=2
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=6000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CLAIM_VERIFIER_PROVIDER=groq
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
CLAIM_VERIFIER_MODEL=openai/gpt-oss-120b
RAG_FAIL_CLOSED=true
RAG_ALLOW_UNPUBLISHED=false
CELERY_ENABLED=true
REDIS_URL=redis://redis:6379/0
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
RAG_TRACE_RETENTION_DAYS=30
RAGAS_ENABLED=true
CORS_ORIGINS=https://example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_TO_AT_LEAST_12_CHARACTERS

# Public HTTPS origin of the frontend, used for BFF CSRF validation
APP_ORIGIN=https://app.example.com
# Backend address reachable from the Next.js runtime (Compose sets this automatically)
API_INTERNAL_URL=http://api:8000
