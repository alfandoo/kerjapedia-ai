APP_ENV=production
PROJECT_ROOT=/workspace
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
SESSION_TTL_MINUTES=480
CORS_ORIGINS=https://app.example.com
RATE_LIMIT_PER_MINUTE=60

POSTGRES_DB=kerjapedia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://postgres:replace-password@postgres:5432/kerjapedia
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_TIMEOUT_SECONDS=30

VECTOR_STORE=pinecone
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX_NAME=kerjapedia-regulations
PINECONE_NAMESPACE=production
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=1200

PUBLIC_API_URL=https://api.example.com
