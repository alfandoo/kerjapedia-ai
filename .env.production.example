APP_ENV=production
PROJECT_ROOT=/workspace
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/kerjapedia
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=kerjapedia-regulations-v2
PINECONE_NAMESPACE=production
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
INGESTION_EMBEDDING_BATCH_SIZE=16
INGESTION_EMBEDDING_TIMEOUT_SECONDS=120
INGESTION_EMBEDDING_MAX_RETRIES=3
INGESTION_EMBEDDING_RETRY_INITIAL_SECONDS=1
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_WRITE_TIMEOUT_SECONDS=60
PINECONE_WRITE_MAX_RETRIES=3
INGESTION_TARGET_TOKENS=350
INGESTION_MAX_TOKENS=550
INGESTION_OVERLAP_TOKENS=60
INGESTION_MIN_MERGE_TOKENS=180
INGESTION_PARENT_TOKENS=1200
INGESTION_OCR_JOBS=2
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
RERANKER_PROVIDER=pinecone
RERANKER_MODEL=bge-reranker-v2-m3
CLAIM_VERIFIER_PROVIDER=openrouter
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
CLAIM_VERIFIER_MODEL=openai/gpt-oss-120b
RAG_FAIL_CLOSED=true
RAG_ALLOW_UNPUBLISHED=false
CELERY_ENABLED=true
REDIS_URL=redis://redis:6379/0
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
RAG_TRACE_RETENTION_DAYS=30
RAGAS_ENABLED=true
HF_HOME=/workspace/model-cache
CORS_ORIGINS=https://example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_TO_AT_LEAST_12_CHARACTERS

# Public HTTPS origin of the frontend, used for BFF CSRF validation
APP_ORIGIN=https://app.example.com
# Backend address reachable from the Next.js runtime (Compose sets this automatically)
API_INTERNAL_URL=http://api:8000
